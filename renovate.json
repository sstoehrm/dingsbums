{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates in one PR",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "minor and patch"
    },
    {
      "description": "shadow-cljs comes from npm (the build tool) and deps.edn (its Clojure side): versions must match",
      "matchPackageNames": [
        "shadow-cljs",
        "thheller:shadow-cljs"
      ],
      "groupName": "shadow-cljs"
    },
    {
      "description": "The tools CI downloads (Node, Clojure CLI, babashka, OSV-Scanner, slsa-verifier, Syft, clj-kondo, cyclonedx-npm) in one PR",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "CI toolchain"
    },
    {
      "description": "setup-node/setup-java read their version from the workflow env, which the custom manager updates; skip the placeholders",
      "matchManagers": [
        "github-actions"
      ],
      "matchCurrentValue": "/^\\$\\{\\{/",
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in workflow and action env: a '# renovate:' comment above NAME_VERSION: x.y.z, and the release asset's checksum in NAME_SHA256 below it, if any",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+[A-Z_]+_VERSION:\\s*(?<currentValue>[^\\s]+)(?:\\s+[A-Z_]+_SHA256:\\s*(?<currentDigest>[0-9a-f]{64}))?"
      ]
    },
    {
      "customType": "regex",
      "description": "npm tools run with npx at a pinned version",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/vuln-gate/README\\.md$/"
      ],
      "matchStrings": [
        "npx --yes (?<depName>(?:@[\\w.-]+/)?[\\w.-]+)@(?<currentValue>\\d[^\\s]*)"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
